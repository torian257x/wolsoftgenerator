{
    "name": "torian257x/wolsoftgenerator",
    "homepage": "https://github.com/torian257x/wolsoftgenerator",
    "description": "Test harness for php-json-schema-model-generator — runs extensive complex-schema tests and creates upstream PRs",
    "type": "project",
    "minimum-stability": "dev",
    "license": "MIT",
    "authors": [
        {
            "name": "torian257x"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/php-json-schema-model-generator",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/php-json-schema-model-generator-production",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "wol-soft/php-json-schema-model-generator": "dev-v3ready-ai-fixed",
        "wol-soft/php-json-schema-model-generator-production": "dev-v3ready",
        "wol-soft/php-micro-template": "^1.10.2",
        "php": "^8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^1.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "PHPModelGenerator\\Tests\\": "packages/php-json-schema-model-generator/tests"
        }
    }
}
